rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Riconoscimento amministratore ───────────────────────────────────────
    // Milestone A Console Admin (decisione §18.3 / §8):
    //   isAdmin() = UID legacy hardcoded  OR  staff/{uid}.admin === true
    // Il UID legacy resta come fallback di retrocompatibilità: NON va ancora
    // rimosso dagli altri file. Il ramo staff.admin è null-safe:
    //   - exists() evita il get() su un documento inesistente;
    //   - .data.get('admin', false) restituisce false se il campo manca.
    // Un ragazzo (doc solo in "utenti") non ha un doc "staff": non può quindi
    // diventare admin nemmeno impostandosi "admin: true" sul proprio doc utenti.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'mCSgNMVEphVIIf4HX0bkcKq2ZKv2'
        || (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid))
          && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('admin', false) == true
        )
      );
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Self-service whitelist (fix R1 / D1, decisione §18.3) ────────────────
    // Un utente autenticato può aggiornare SOLO questi campi sul PROPRIO
    // documento di identità (utenti/staff/amici). Ogni campo che determina
    // privilegi, ruolo, appartenenza o autorizzazioni resta scrivibile solo
    // dall'admin. Gli elenchi sono ricavati dai writer client-side realmente
    // presenti nel codice (js/auth.js, js/nav-auth.js, js/notifiche.js,
    // profilo.html) — vedi AUDIT-CONSOLE-ADMIN.md §Milestone A.
    //
    //  - numeroAccessi : js/auth.js (increment al login, sul proprio doc)
    //  - primoAccesso  : js/nav-auth.js (una tantum, solo su "utenti")
    //  - fcmTokens/fcmToken : js/notifiche.js (token push, sul proprio doc)
    //  - fotoProfilo/fotoCover/miPresento/updatedAt/audioUrl : profilo.html
    //    (editor del proprio profilo, guardato da isOwner lato client)
    //  - interazioni   : profilo.html incrInt() — SOLO contatore cosmetico,
    //    mostrato ai soli admin; il client lo incrementa sul PROPRIO doc
    //    (utenti/staff, mai amici). Le scritture cross-utente di "interazioni"
    //    oggi falliscono già in silenzio e restano vietate: qui NON si
    //    introduce alcuna clausola cross-utente per questo campo.
    function utenteSelfServiceFields() {
      return ['numeroAccessi', 'primoAccesso', 'fcmTokens', 'fcmToken',
              'fotoProfilo', 'fotoCover', 'miPresento', 'updatedAt',
              'audioUrl', 'interazioni'];
    }
    function staffSelfServiceFields() {
      return ['numeroAccessi', 'fcmTokens', 'fcmToken',
              'fotoProfilo', 'fotoCover', 'miPresento', 'updatedAt',
              'audioUrl', 'interazioni'];
    }
    function amicoSelfServiceFields() {
      return ['fcmTokens', 'fcmToken',
              'fotoProfilo', 'fotoCover', 'miPresento', 'updatedAt', 'audioUrl'];
    }
    function isSelfServiceUpdate(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ── Utenti ──────────────────────────────────────────────
    match /utenti/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) || isAdmin();
      // Fix R1/D1: il proprietario NON può più modificare campi di sistema
      // (accessoDocumenti, comunitaId, stato, admin, ruolo, permissions,
      // email, nome, …). Solo la whitelist self-service, oppure l'admin.
      allow update: if isAdmin()
                    || (isOwner(uid) && isSelfServiceUpdate(utenteSelfServiceFields()))
                    // Qualsiasi utente loggato può aggiornare solo il campo
                    // reazioniPresento (reazioni alla "Mi Presento" altrui) —
                    // comportamento invariato rispetto alle regole precedenti.
                    || (isLoggedIn() && isSelfServiceUpdate(['reazioniPresento']));
      allow delete: if isAdmin();

      // Reazioni su "Mi Presento": ogni utente gestisce solo la propria
      match /reazioniPresento/{reazId} {
        allow read: if true;
        allow write: if isLoggedIn() && request.auth.uid == reazId;
      }

      // ── Storico appartenenze alle comunità (Milestone D) ─────────────────
      // Dato AMMINISTRATIVO append-only. read: solo admin (NON allargato in D;
      // un eventuale accesso storico per la comunità attuale è milestone a sé).
      //
      // CREATE (solo admin), due forme:
      //  (a) record APERTO normale:
      //      chiavi = {comunitaId, dal, al, causale, actorUid, createdAt}
      //      actorUid == auth.uid ; dal == createdAt == request.time ; al == null
      //  (b) BASELINE legacy (ragazzo con utenti.comunitaId ma senza storico):
      //      chiavi = {..sopra.., legacyBaseline}
      //      legacyBaseline == true ; al == request.time (chiuso alla nascita)
      //      dal == request.time  => dal == al: durata NULLA. NON è un periodo
      //      reale: la data d'ingresso non è nota e NON viene inventata; il
      //      record registra solo che il ragazzo era in quella comunità prima
      //      dell'introduzione dello storico.
      //  In entrambe: comunitaId stringa non vuota; causale stringa 1..500.
      //
      // UPDATE (solo admin) = CHIUSURA ONE-WAY:
      //   unico campo modificato: 'al'
      //   il record deve essere APERTO (resource.data.al == null)
      //   nuovo 'al' == request.time (no timestamp arbitrari)
      //   tutti gli altri campi immutabili
      //   -> un record già chiuso non è più aggiornabile; 'al:null' per
      //      riaprire fallisce (request.resource.data.al != request.time)
      //
      // DELETE: vietato a chiunque.
      match /appartenenze/{appId} {
        allow read: if isAdmin();

        allow create: if isAdmin()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.dal == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.comunitaId is string
          && request.resource.data.comunitaId.size() > 0
          && request.resource.data.causale is string
          && request.resource.data.causale.size() > 0
          && request.resource.data.causale.size() <= 500
          && (
            (
              request.resource.data.keys().hasOnly(
                ['comunitaId', 'dal', 'al', 'causale', 'actorUid', 'createdAt'])
              && request.resource.data.al == null
            )
            || (
              request.resource.data.keys().hasOnly(
                ['comunitaId', 'dal', 'al', 'causale', 'actorUid', 'createdAt', 'legacyBaseline'])
              && request.resource.data.legacyBaseline == true
              && request.resource.data.al == request.time
            )
          );

        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['al'])
          && resource.data.al == null
          && request.resource.data.al == request.time
          && request.resource.data.comunitaId == resource.data.comunitaId
          && request.resource.data.dal        == resource.data.dal
          && request.resource.data.actorUid   == resource.data.actorUid
          && request.resource.data.createdAt  == resource.data.createdAt
          && request.resource.data.causale    == resource.data.causale;

        allow delete: if false;
      }
    }

    // ── Staff ────────────────────────────────────────────────
    match /staff/{uid} {
      allow read: if true;
      // Fix R1 (decisione §18.3): uno staff NON può auto-attribuirsi/modificare
      // admin, accessoDocumenti, ruolo, comunitaId, permissions, email, nome.
      // Solo la whitelist self-service (foto/miPresento/FCM/accessi/interazioni)
      // oppure l'admin.
      allow update: if isAdmin()
                    || (isOwner(uid) && isSelfServiceUpdate(staffSelfServiceFields()));
      allow create, delete: if isAdmin();
    }

    // ── Amici ────────────────────────────────────────────────
    match /amici/{uid} {
      allow read: if true;
      // Fix R1 (decisione §18.3): stessa protezione dei campi di sistema.
      allow update: if isAdmin()
                    || (isOwner(uid) && isSelfServiceUpdate(amicoSelfServiceFields()));
      allow create, delete: if isAdmin();
    }

    // ── Comunità ─────────────────────────────────────────────
    match /comunita/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Audit log operazioni amministrative (decisione §18.7 / Milestone C) ──
    // Append-only: nessun update/delete, nemmeno per l'admin.
    //   read   : solo admin
    //   create : solo admin, con vincoli di integrità minimi:
    //            - actorUid DEVE coincidere con request.auth.uid (no spoofing)
    //            - ts DEVE essere request.time (serverTimestamp() lato client)
    //            - campi minimi presenti e tipati
    //            - before/after devono essere mappe
    // NOTA: questo NON è un audit crittograficamente non-falsificabile. update
    // e delete sono vietati dalle regole, ma un admin compromesso potrebbe
    // comunque creare voci arbitrarie (purché ben formate). L'integrità forte
    // richiederà una scrittura server-side (Admin SDK) in una milestone futura.
    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.keys().hasAll(
             ['ts', 'actorUid', 'action', 'targetType', 'targetId', 'before', 'after'])
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 3
        && request.resource.data.action.size() <= 64
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.before is map
        && request.resource.data.after is map;
      allow update, delete: if false;
    }

    // ── PIN login ragazzi (Gestione ragazzi) ──────────────────
    // Modello Robinson (robinson_pin / robinson_pin_lookup): il login con
    // PIN torna a essere client-side, senza Cloud Function. utenti_pin
    // contiene il PIN in chiaro e resta riservato all'admin — un ragazzo non
    // ne ha bisogno per accedere (lo conosce già, l'ha digitato).
    match /utenti_pin/{uid} {
      allow read, write: if isAdmin();
    }

    // Lookup pubblico, necessario per il login senza autenticazione previa
    // (come robinson_pin_lookup). A differenza di Robinson, qui NON viene
    // mai salvata la password: solo { uid, email }. La password si
    // ricostruisce lato client con la stessa formula nota sia in creazione
    // sia in login (vedi js/ragazzi-pin.js), quindi non deve mai comparire
    // in un documento leggibile pubblicamente.
    match /utenti_pin_lookup/{pin} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contatori di rate limit del login PIN (IP con hash, mai in chiaro),
    // scritti e letti solo da loginRagazzoConPin tramite Admin SDK: nessun
    // client deve poter leggerli o, peggio, azzerarli da solo.
    match /pin_login_rate/{ipHash} {
      allow read, write: if isAdmin();
    }

    // ── Riserve PIN (Milestone E) ────────────────────────────────
    // Marker deterministico di unicità del PIN: doc-id = PIN, { uid, createdAt }.
    // Scritto/letto SOLO dalla callable creaRagazzoAdmin tramite Admin SDK, che
    // bypassa queste regole. Nessun client (admin incluso) deve poterlo leggere,
    // enumerare, creare o cancellare: un PIN riservato non deve mai trapelare.
    match /pin_reservations/{pin} {
      allow read, write: if false;
    }

    // ── PPU: Scheda A "Come mi vedo" ───────────────────────────
    // Stessa logica autorizzativa già usata per documenti/** in
    // storage.rules (admin, coordinatore/responsabile per comunità, staff
    // con accessoDocumenti per comunità) — qui riscritta con get()/exists()
    // dirette perché siamo già dentro le regole di Firestore (senza il
    // prefisso "firestore." richiesto invece da storage.rules). Un ragazzo
    // autenticato via PIN non ha mai un doc in "staff", quindi non rientra
    // in nessuna di queste funzioni.
    function staffDocPPU() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isStaffMemberPPU() {
      return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function staffComunitaMatchPPU(comunitaId) {
      let c = staffDocPPU().data.get('comunitaId', null);
      return (c is list && comunitaId in c) || c == comunitaId;
    }
    // ── Semantica TRI-STATE del permesso Documenti (Milestone C) ────────────
    //   accessoDocumenti === true   -> accesso concesso (PREVALE sul ruolo)
    //   accessoDocumenti === false  -> accesso negato   (PREVALE sul ruolo)
    //   campo assente               -> fallback legacy: ruolo coordinat/responsabil
    // Formula: campo presente ? (=== true) : ruoloLegacy
    function staffRuoloLegacyPPU() {
      return staffDocPPU().data.get('ruolo', '').lower().matches('.*(coordinat|responsabil).*');
    }
    function staffDocumentiPolicyPPU() {
      return isStaffMemberPPU()
        && (
          ('accessoDocumenti' in staffDocPPU().data)
            ? (staffDocPPU().data.accessoDocumenti == true)
            : staffRuoloLegacyPPU()
        );
    }
    function canAccessPPU(comunitaId) {
      return isAdmin()
        || (staffDocumentiPolicyPPU() && staffComunitaMatchPPU(comunitaId));
    }

    match /ppu_schede_a/{schedaId} {
      allow read: if canAccessPPU(resource.data.comunitaId);
      allow create: if canAccessPPU(request.resource.data.comunitaId)
        && request.resource.data.createdBy == request.auth.uid;
      // comunitaId/minorId/createdBy/createdAt sono immutabili dopo la
      // creazione: nessun client può riattribuire chi/quando ha creato la
      // scheda né spostarla su un altro ragazzo o comunità.
      allow update: if canAccessPPU(resource.data.comunitaId)
        && request.resource.data.comunitaId == resource.data.comunitaId
        && request.resource.data.minorId == resource.data.minorId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ── PPU: Scheda B "Come penso che mi vedano gli altri" ────
    // Stessa logica autorizzativa della Scheda A (riusa gli helper
    // canAccessPPU / staffDocPPU / … definiti sopra): admin,
    // coordinatore/responsabile per comunità, staff con accessoDocumenti
    // per comunità. Cambia solo il nome della collezione.
    match /ppu_schede_b/{schedaId} {
      allow read: if canAccessPPU(resource.data.comunitaId);
      allow create: if canAccessPPU(request.resource.data.comunitaId)
        && request.resource.data.createdBy == request.auth.uid;
      // comunitaId/minorId/createdBy/createdAt immutabili dopo la creazione.
      allow update: if canAccessPPU(resource.data.comunitaId)
        && request.resource.data.comunitaId == resource.data.comunitaId
        && request.resource.data.minorId == resource.data.minorId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ── Diario ───────────────────────────────────────────────
    match /diario/{postId} {
      allow read: if true;
      // Solo il proprietario del profilo può creare post nel proprio diario
      allow create: if isLoggedIn()
                    && request.auth.uid == request.resource.data.uidRagazzo;
      // Il proprietario/admin possono aggiornare tutto il documento;
      // qualsiasi utente loggato può aggiornare SOLO il campo reazioni (contatori).
      allow update: if isLoggedIn()
                    && (
                      request.auth.uid == resource.data.uidRagazzo
                      || isAdmin()
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reazioni'])
                    );
      allow delete: if isLoggedIn()
                    && (request.auth.uid == resource.data.uidRagazzo || isAdmin());

      // Commenti al diario: scrivibili solo dai loggati
      match /commenti/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow delete: if isLoggedIn()
                      && (request.auth.uid == resource.data.uidAutore || isAdmin());
        allow update: if false;
      }

      // Reazioni ai post: ogni utente gestisce solo la propria
      match /reazioni/{userId} {
        allow read: if true;
        allow write: if isLoggedIn() && request.auth.uid == userId;
      }
    }

    // ── Piazzetta ────────────────────────────────────────────
    match /piazzetta_posts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        request.auth.uid == resource.data.authorId
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'commentsCount'])
      );
      allow delete: if isLoggedIn() &&
        (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow update: if isLoggedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isLoggedIn() &&
          (request.auth.uid == resource.data.authorId || isAdmin());
      }

      match /user_reactions/{userId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && request.auth.uid == userId;
      }
    }

    // ── Notifiche (contatore non lette per utente) ──────────
    match /notifiche/{uid} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ===== ROBINSON =====

    // La Spiaggia - post condivisi
    match /robinson_spiaggia/{postId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        request.auth.uid == resource.data.authorId
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'commentsCount'])
      );
      allow delete: if isLoggedIn() &&
        (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn();
        allow update: if isLoggedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isLoggedIn() &&
          (request.auth.uid == resource.data.authorId || isAdmin());
      }

      match /user_reactions/{userId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && request.auth.uid == userId;
      }
    }

    // Diario della ciurma - racconto quotidiano dell'équipe educativa
    match /robinson_diario_ciurma/{postId} {
      allow read: if isLoggedIn();
      // Solo chi è nella ciurma (o l'admin) può scrivere una pagina di diario
      allow create: if isLoggedIn() &&
        (isAdmin() || exists(/databases/$(database)/documents/robinson_ciurma/$(request.auth.uid)));
      allow update: if isLoggedIn() && (
        request.auth.uid == resource.data.authorId
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'commentsCount'])
      );
      allow delete: if isLoggedIn() &&
        (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn();
        allow update: if isLoggedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isLoggedIn() &&
          (request.auth.uid == resource.data.authorId || isAdmin());
      }

      match /user_reactions/{userId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && request.auth.uid == userId;
      }
    }

    // I Naufraghi - profili
    match /robinson_naufraghi/{uid} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && (isOwner(uid) || isAdmin());

      match /profilo/{docId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && (isOwner(uid) || isAdmin());
      }

      match /carta_identita/{docId} {
        allow read: if isLoggedIn();
        allow create: if isOwner(uid) || isAdmin();
        allow update: if isAdmin() ||
          (isOwner(uid) && resource.data.get('bloccata', false) == false);
        allow delete: if isAdmin();
      }

      match /notte_partenza/{docId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null &&
          get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data.ruolo == 'admin';
      }
    }

    // Diari personali naufraghi
    match /robinson_diari/{uid}/{document=**} {
      allow read: if request.auth != null;
      // write solo tramite regole specifiche /posts/{postId}
    }

    match /robinson_diari/{uid}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid && resource.data.get('bloccata', false) == false) ||
        // Tesori: aggiornamento solo del campo media sempre consentito al proprietario
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['media', 'timestamp']))
      );
      allow delete: if isAdmin();

      match /reactions/{userId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && request.auth.uid == userId;
      }

      match /commenti/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn();
        allow delete: if isLoggedIn() &&
          (request.auth.uid == resource.data.authorId || isOwner(uid) || isAdmin());
        allow update: if false;
      }
    }

    // La Ciurma - operatori Robinson
    match /robinson_ciurma/{uid} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Robinson: Dicono di me ──────────────────────────────────────────────
    match /robinson_dicono/{uid}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid != uid;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.autorId ||
         get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data.ruolo == 'admin');
    }
    match /robinson_dicono/{uid}/posts/{postId}/reactions/{rId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /robinson_dicono/{uid}/posts/{postId}/commenti/{cId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Isola dei Sentimenti ─────────────────────────────────
    match /robinson_isola/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /robinson_isola/{uid}/notti/{data} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── PIN Login naufraghi ──────────────────────────────────────
    match /robinson_pin/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Lookup pubblico (necessario per il login senza auth)
    match /robinson_pin_lookup/{pin} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /robinson_isola_presenze/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── Archivio notturno isola ──────────────────────────────
    match /robinson_isola_archivio/{data} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Villaggio ────────────────────────────────────────────
    match /robinson_villaggio/{casaId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Villaggio: valutazioni giornaliere pulizia/organizzazione (admin-only) ──
    match /robinson_villaggio_valutazioni/{valutazioneId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Punteggi Robinson ────────────────────────────────────
    match /robinson_punteggi/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Bottiglie Robinson (messaggi tra naufraghi) ──────────
    match /robinson_bottiglie/{uid}/messaggi/{msgId} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow delete: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
    }

    // ── Inviati Robinson (copia messaggi inviati) ────────────
    match /robinson_inviati/{uid}/messaggi/{msgId} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── Richieste di modifica carta d'identità ───────────────
    match /robinson_richieste/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
    }

    // ── Notte prima dello sbarco (Robinson) ─────────────────
    match /notte_sbarco/{uid} {
      allow read: if isLoggedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ── Messaggi in Bottiglia ────────────────────────────────
    match /messaggiBottiglia/{bottId} {
      allow read: if true;  // lettura pubblica (sola lettura per non loggati)
      allow create: if isLoggedIn()
                    && request.auth.uid == request.resource.data.uidMittente
                    && request.auth.uid != request.resource.data.uidDestinatario;
      allow update: if isLoggedIn()
                    && (
                      request.auth.uid == resource.data.uidDestinatario
                      || isAdmin()
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reazioni'])
                    );
      allow delete: if isLoggedIn()
                    && (request.auth.uid == resource.data.uidDestinatario
                        || request.auth.uid == resource.data.uidMittente
                        || isAdmin());

      // Commenti alle bottiglie
      match /commenti/{commentId} {
        allow read: if true;  // leggibili anche da non loggati
        allow create: if isLoggedIn();
        allow delete: if isLoggedIn()
                      && (request.auth.uid == resource.data.uidAutore || isAdmin());
        allow update: if false;
      }

      // Reazioni alle bottiglie
      match /reazioni/{userId} {
        allow read: if true;  // leggibili anche da non loggati
        allow write: if isLoggedIn() && request.auth.uid == userId;
      }
    }

    // ── Attività (hub ATTIVITÀ + Il Consiglio dell'Isola) ────────────────
    function isEducatore() {
      return isAdmin(); // estendibile: aggiungere altri uid in questa funzione
    }
    function rilevazioneAperta(attId, rilId) {
      return get(/databases/$(database)/documents/attivita/$(attId)/rilevazioni/$(rilId)).data.stato == 'aperta';
    }

    match /attivita/{attId} {
      allow read: if isLoggedIn();
      allow write: if isEducatore();

      match /rilevazioni/{rilId} {
        allow read: if isLoggedIn();              // meta + sintesiPubblica (no PII)
        allow write: if isEducatore();

        match /risposte/{userId} {
          allow read: if isEducatore() || (isLoggedIn() && request.auth.uid == userId);
          allow create, update: if isLoggedIn() && request.auth.uid == userId
            && rilevazioneAperta(attId, rilId);
          allow delete: if isEducatore();
        }
      }
    }

    // ── Bussola del gruppo — questionario "Migliori/Peggiori/Chi può migliorare" ──────
    // Strumento diagnostico admin-only: nessun naufrago vede MAI le risposte altrui né gli
    // aggregati (list riservato all'admin: impedisce l'enumerazione dell'intera collezione).
    // get invece è aperto anche al proprietario perché bussola-gruppo.html lo usa per il
    // resume della propria compilazione (rilegge SOLO il proprio doc, mai quello di altri).
    // Update consentito al proprietario finché il documento non è bloccato dall'admin (stesso
    // pattern di robinson_naufraghi/carta_identita); reset/delete solo admin.
    match /robinson_questionario_campo/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin() ||
        (isOwner(uid) && resource.data.get('bloccata', false) == false);
      allow delete: if isAdmin();
    }

    // ── Sociogramma di rifiuto — item singolo, dati riservati alla vista educatore ──
    match /robinson_sociogramma_rifiuto/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isAdmin();
    }

    // ── Gestione: Magazzino & Lista spesa (NON deployare senza ok esplicito di Giacomo) ──
    // Accesso solo admin o persone abilitate dall'admin (PIN Robinson risolto a UID
    // stabile, vedi robinson/js/robinson-magazzino.js:puoAccedereGestione).
    function puoAccedereGestione() {
      return isAdmin() ||
        (isLoggedIn() && exists(/databases/$(database)/documents/magazzino_autorizzati/$(request.auth.uid)));
    }

    match /magazzino_categorie/{doc} { allow read, write: if puoAccedereGestione(); }
    match /magazzino_prodotti/{doc}  { allow read, write: if puoAccedereGestione(); }
    match /liste_spesa/{id} {
      allow read, write: if puoAccedereGestione();
      match /voci/{voceId} { allow read, write: if puoAccedereGestione(); }
    }
    // Regola separata per la collection-group query su "voci" usata dallo storico
    // (gestione-storico.html: collectionGroup(db,'voci')) — la match annidata sopra
    // copre solo le letture dirette sotto liste_spesa/{id}/voci, non la collection group.
    match /{path=**}/voci/{voceId} { allow read: if puoAccedereGestione(); }
    match /magazzino_autorizzati/{uid} {
      allow read: if puoAccedereGestione();
      allow write: if isAdmin();
    }
  }
}
