rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'mCSgNMVEphVIIf4HX0bkcKq2ZKv2';
    }

    function isMassimo() {
      return request.auth != null
        && request.auth.uid == '0u41pvwSTAaryAGWAG8gwuxrZ293';
    }

    function isSuperUser() {
      return isAdmin() || isMassimo();
    }

    function staffRef(uid) {
      return /databases/(default)/documents/staff/$(uid);
    }

    // Qualsiasi membro dello staff autenticato
    function isStaff() {
      return request.auth != null
        && firestore.exists(staffRef(request.auth.uid));
    }

    function staffData() {
      return firestore.get(staffRef(request.auth.uid)).data;
    }

    function staffComunita() {
      return firestore.get(staffRef(request.auth.uid)).data.get('comunitaId', null);
    }

    // ── Semantica TRI-STATE del permesso Documenti (Milestone C) ────────────
    // Allineata a firestore.rules (canAccessPPU) e a documenti.html / nav-docs.js:
    //   accessoDocumenti === true   -> accesso concesso (PREVALE sul ruolo)
    //   accessoDocumenti === false  -> accesso negato   (PREVALE sul ruolo)
    //   campo assente               -> fallback legacy: ruolo coordinat/responsabil
    // Formula: campo presente ? (=== true) : ruoloLegacy
    // Criterio ruolo: sottostringa case-insensitive coordinat/responsabil,
    // identico a documenti.html (ruolo.toLowerCase().includes(...)).
    function staffRuoloLegacy() {
      return isStaff() && staffData().get('ruolo', '').lower().matches('.*(coordinat|responsabil).*');
    }
    function staffDocumentiPolicy() {
      return isStaff()
        && (
          ('accessoDocumenti' in staffData())
            ? (staffData().accessoDocumenti == true)
            : staffRuoloLegacy()
        );
    }

    function comunitaInScope(comunitaId) {
      let c = staffComunita();
      return (c is list && comunitaId in c) || c == comunitaId;
    }

    function canAccessDocumentiComunita(comunitaId) {
      return isSuperUser()
        || (staffDocumentiPolicy() && comunitaInScope(comunitaId));
    }

    // Documenti Generali/Segreteria non è legato a una comunità: nessuno scoping,
    // ma stessa politica tri-state (in precedenza il ruolo concedeva comunque
    // l'accesso anche con accessoDocumenti === false).
    function canAccessDocumentiGenerali() {
      return isSuperUser() || staffDocumentiPolicy();
    }

    // ── Documenti Generali / Segreteria ──────────────────────────
    // documenti.html mostra il bottone "Elimina" solo all'admin (canDel =
    // isAdmin, sia qui che per le comunità sotto): read/create/update sono
    // concessi anche a coordinatore/responsabile/accessoDocumenti, ma delete
    // resta riservato al super user — distinzione fatta qui a livello di
    // regola, non solo nascondendo il bottone in UI.
    match /documenti/documenti-generali/{file} {
      allow read, create, update: if canAccessDocumentiGenerali();
      allow delete: if isSuperUser();
    }

    // ── Area Documenti per comunità (fascicoli, PPU inclusa) ──────
    // Struttura: documenti/{comunitaId}/{uid}/{area}/{...sottocartelle}/{file}
    // Nessun ragazzo autenticato via PIN (o via qualunque altro account "utenti")
    // rientra in nessuna delle funzioni sopra: un ragazzo non ha un doc in
    // "staff", quindi qui non ottiene mai accesso, nemmeno al proprio fascicolo.
    // Stessa distinzione delete-solo-admin di Documenti Generali (vedi sopra).
    match /documenti/{comunitaId}/{allPaths=**} {
      allow read, create, update: if canAccessDocumentiComunita(comunitaId);
      allow delete: if isSuperUser();
    }

    // ── Tutto il resto (foto profilo, audio, media) ───────────────
    // Verifica del 2026-08-26: nessun codice client (sito principale o Robinson)
    // usa oggi l'SDK di Firebase Storage al di fuori di documenti/** — foto e
    // audio passano tutti da Cloudinary. Questa regola resta comunque per non
    // rompere eventuali percorsi non tracciati in questo repository, ma esclude
    // ESPLICITAMENTE il prefisso "documenti": le regole di Storage sono un OR
    // fra tutti i match che corrispondono allo stesso path, quindi senza questa
    // esclusione un catch-all "chiunque loggato" riaprirebbe l'accesso che le
    // regole sopra intendono restringere (è esattamente il bug corretto qui).
    match /{prefix}/{allPaths=**} {
      allow read, write: if prefix != 'documenti' && request.auth != null;
    }
  }
}
